            "content": "// src/components/cart/Cart.jsx\r\nimport React, { useEffect, useState } from \"react\";\r\nimport { Link } from \"react-router-dom\";\r\n\r\nconst CART_KEY = \"cart_items\";\r\n\r\nconst Cart = () => {\r\n  const [cartItems, setCartItems] = useState([]);\r\n\r\n  // load cart on mount\r\n  useEffect(() => {\r\n    const stored = JSON.parse(localStorage.getItem(CART_KEY)) || [];\r\n    setCartItems(stored);\r\n  }, []);\r\n\r\n  // persist cart\r\n  const updateCart = (items) => {\r\n    setCartItems(items);\r\n    localStorage.setItem(CART_KEY, JSON.stringify(items));\r\n  };\r\n\r\n  // remove item\r\n  const removeItem = (id) => {\r\n    const ok = window.confirm(\"Remove this item from cart?\");\r\n    if (!ok) return;\r\n\r\n    const updated = cartItems.filter((item) => item.id !== id);\r\n    updateCart(updated);\r\n  };\r\n\r\n  // quantity handlers\r\n  const increaseQty = (id) => {\r\n    const updated = cartItems.map((item) =>\r\n      item.id === id ? { ...item, qty: item.qty + 1 } : item\r\n    );\r\n    updateCart(updated);\r\n  };\r\n\r\n  const decreaseQty = (id) => {\r\n    const updated = cartItems.map((item) =>\r\n      item.id === id && item.qty > 1\r\n        ? { ...item, qty: item.qty - 1 }\r\n        : item\r\n    );\r\n    updateCart(updated);\r\n  };\r\n\r\n  const subtotal = cartItems.reduce(\r\n    (sum, item) => sum + item.price * item.qty,\r\n    0\r\n  );\r\n\r\n  // empty cart\r\n  if (cartItems.length === 0) {\r\n    return (\r\n      <section className=\"cart-area pt-120 pb-120 text-center\">\r\n        <h2>Your cart is empty</h2>\r\n        <Link to=\"/shop\" className=\"tp-btn-h1 mt-4\">\r\n          Continue Shopping\r\n        </Link>\r\n      </section>\r\n    );\r\n  }\r\n\r\n  return (\r\n    <section className=\"cart-area pt-120 pb-120\">\r\n      <div className=\"container\">\r\n        <div className=\"table-content table-responsive\">\r\n          <table className=\"table cart-table align-middle\">\r\n            <thead>\r\n              <tr>\r\n                <th>Image</th>\r\n                <th>Product</th>\r\n                <th>Unit Price</th>\r\n                <th>Quantity</th>\r\n                <th>Total</th>\r\n                <th>Remove</th>\r\n              </tr>\r\n            </thead>\r\n\r\n            <tbody>\r\n              {cartItems.map((item) => (\r\n                <tr key={item.id}>\r\n                  <td>\r\n                    <img src={item.image} alt={item.name} width=\"80\" />\r\n                  </td>\r\n\r\n                  <td>\r\n                    <Link to={`/product/${item.slug}`}>{item.name}</Link>\r\n                  </td>\r\n\r\n                  <td>${item.price.toFixed(2)}</td>\r\n\r\n                  <td>\r\n                    <div className=\"qty-box\">\r\n                      <button onClick={() => decreaseQty(item.id)}>−</button>\r\n                      <input value={item.qty} readOnly />\r\n                      <button onClick={() => increaseQty(item.id)}>+</button>\r\n                    </div>\r\n                  </td>\r\n\r\n                  <td>${(item.price * item.qty).toFixed(2)}</td>\r\n\r\n                  <td>\r\n                    <button\r\n                      className=\"remove-btn\"\r\n                      onClick={() => removeItem(item.id)}\r\n                    >\r\n                      ✕\r\n                    </button>\r\n                  </td>\r\n                </tr>\r\n              ))}\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n\r\n        <div className=\"row justify-content-end mt-5\">\r\n          <div className=\"col-md-5\">\r\n            <div className=\"cart-page-total\">\r\n              <h2>Cart Totals</h2>\r\n              <ul>\r\n                <li>\r\n                  Subtotal <span>${subtotal.toFixed(2)}</span>\r\n                </li>\r\n                <li>\r\n                  Total <span>${subtotal.toFixed(2)}</span>\r\n                </li>\r\n              </ul>\r\n\r\n              <Link to=\"/checkout\" className=\"tp-btn-h1 w-100\">\r\n                Proceed to Checkout\r\n              </Link>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  );\r\n};\r\n\r\nexport default Cart;\r\n"
        }
    ]
}